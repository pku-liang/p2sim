set unstable

run-all: \
    (run-target-all "rocket_m_1") \
    (run-target-all "rocket_m_2") \
    (run-target-all "rocket_m_4") \
    (run-target-all "boom_m_1") \
    (run-target-all "boom_m_2") \
    (run-target-all "boom_m_4") \
    (run-target-all "boom_l_1") \
    (run-target-all "boom_l_2") \
    (run-target-all "boom_l_4")

run-target-all target: \
    (prof-1234 target "coremark-2.bin")

prof-1234 target exe: \
    (prof target exe "1") \
    (prof target exe "2") \
    (prof target exe "3") \
    (prof target exe "4") \
    (prof target exe "5") \
    (prof target exe "6") \
    (prof target exe "7") \
    (prof target exe "8") \
    (prof target exe "10") \
    (prof target exe "12") \
    (prof target exe "14") \
    (prof target exe "16") \
    (prof target exe "20") \
    (prof target exe "24") \
    (prof target exe "28") \
    (prof target exe "32")

[parallel]
compile-1234 target: \
    (compile target "1") \
    (compile target "2") \
    (compile target "3") \
    (compile target "4") \
    (compile target "5") \
    (compile target "6") \
    (compile target "7") \
    (compile target "8") \
    (compile target "10") \
    (compile target "12") \
    (compile target "14") \
    (compile target "16") \
    (compile target "20") \
    (compile target "24") \
    (compile target "28") \
    (compile target "32")

[script("bash")]
prof target exe threads:
    target_dir=build/{{ target }}.T{{ threads }}
    bind_cpus=48-$((48 + {{ threads }}))
    MAX_CYCLES=100000 taskset -c $bind_cpus $target_dir/sim.vlt ./exe/{{ exe }} || true
    mkdir -p $target_dir/prof.vlt
    env \
        MAX_CYCLES=500000 \
        PROF_FILE=$target_dir/prof.vlt/{{ exe }} \
        taskset -c $bind_cpus \
        $target_dir/sim.vlt ./exe/{{ exe }} \
        > >(tee $target_dir/prof.vlt/{{ exe }}.out) \
        2> >(tee $target_dir/prof.vlt/{{ exe }}.log >&2) \
        || true

compile target threads:
    mkdir -p build/{{ target }}.T{{ threads }}/verilated
    pixi run verilator \
        --cc \
        --exe \
        --threads {{ threads }} \
        --top TestHarness \
        -Wno-fatal \
        emu/EICG_wrapper.v \
        emu/plusarg_reader.v \
        rsrc/{{ target }}.sv \
        emu/emu.cc \
        -Mdir build/{{ target }}.T{{ threads }}/verilated 
    pixi run make \
        -C build/{{ target }}.T{{ threads }}/verilated \
        -f VTestHarness.mk \
        CXX=clang++
    cp build/{{ target }}.T{{ threads }}/verilated/VTestHarness build/{{ target }}.T{{ threads }}/sim.vlt