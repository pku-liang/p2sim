#pragma once

#include <cstdint>
#include <cstring>
#include <cstdio>
#include <cstdarg>
#include <cassert>

#define gdiv(a, b) ((b) == 0 ? 0 : (a) / (b))

#ifndef __BITINT_MAXWIDTH__
#error  BITINT support is required
#endif

#ifdef __clang__
#if __clang_major__ < 19
#error  Please compile with clang 19 or above
#endif
#endif

{% for i in 2..=design.max_concat %}
#define UINT_CONCAT{{ i }}(
    {%- for j in 0..i -%}
        _{{ j }} {%- if !loop.last %},{% endif %}
    {%- endfor -%}
) (
    {%- for j in 0..i -%}
        (((unsigned _BitInt({{ i * 64 }}))_{{ j }})<<{{ (i - j - 1) * 64}})
        {%- if !loop.last %}|{% endif %}
    {%- endfor -%}
)
{% endfor %}

struct {{ impl_name }} {
    void step();
    void init();

    static void gprintf(const char *fmt, ...);

{%- for state in design.states %}
    {%- if state.kind == StateKind::Input %}
    void set_{{ state.name }}({{ state.width | int_ty }} data);
    {%- endif %}
{%- endfor %}

{%- for logic in 0..logics.len() %}
    void substep_{{ logic }}();
{%- endfor %}
{%- for reset in 0..resets.len() %}
    void subreset_{{ reset }}();
{%- endfor %}

    uint{{ cfg.act_pack }}_t __act_mask[{{ design.logics.len() / cfg.act_pack as usize + 1 }}];

{%- for state in design.states %}
    {{ state.width | int_ty }} {{ state.name }}
    {%- for dim in state.dims -%}
        [{{ dim }}]
    {%- endfor -%};
{%- endfor %}
};
