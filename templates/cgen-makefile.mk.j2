objs := \
	{{ file_map.impl_c }}.o \
	{{ file_map.gprintf_c }}.o
{%- for logic in logics %}\
	{{ logic.0 }}.o
{%- endfor %}
{%- for reset in resets %}\
	{{ reset.0 }}.o
{%- endfor %}

sim: $(objs)
	$(CXX) $(LDFLAGS) $^ -o $@ $(LDLIBS)

{{ file_map.impl_c }}.o: {{ file_map.impl_c }} {{ file_map.impl_h }} {{ file_map.decl_h }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $< -o $@

%.cc.o: %.cc {{ file_map.impl_h }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $< -o $@
