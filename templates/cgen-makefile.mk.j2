objs := \
	{{ file_map.impl_c }}.o \
	{{ file_map.gprintf_c }}.o
{%- for logic in logics %}\
	{{ logic.0 }}.o
{%- endfor %}
{%- for reset in resets %}\
	{{ reset.0 }}.o
{%- endfor %}
{%- for extra in file_map.extra %}\
	{{ extra | hashed_name }}.o
{%- endfor %}

CXXFLAGS += -I.
CXXFLAGS += -O2
CXXFLAGS += -DDUT_NAME="{{ decl_name }}"
CXXFLAGS += -DDUT_HEADER="\"{{ file_map.decl_h }}\""

sim: $(objs)
	$(CXX) $(LDFLAGS) $^ -o $@ $(LDLIBS)

{{ file_map.impl_c }}.o: {{ file_map.impl_c }} {{ file_map.impl_h }} {{ file_map.decl_h }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $< -o $@

%.cc.o: %.cc {{ file_map.impl_h }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $< -o $@

{%- for extra in file_map.extra %}
{{ extra | hashed_name }}.o: {{ extra }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $< -o $@
{%- endfor %}