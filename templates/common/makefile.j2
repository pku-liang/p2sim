CXX = clang++
CXXFLAGS += -pthread -march=native -std=c++20
LDFLAGS += -fuse-ld=lld -pthread -g

{%- if !ctx.cfg.ccargs.debug %}
CXXFLAGS += -O2
{%- endif %}

objs = \
	{{ ctx.smap.impl_cc }}.o
{%- for file in ctx.iter_all_group_files() %} \
	{{ file }}.o
{%- endfor %}
{%- for extra in ctx.smap.extra_cpp %} \
	{{ ctx.smap.extra_obj(extra) }}.o
{%- endfor %}

LDFLAGS +=
{%- for link_dir in ctx.cfg.ccargs.link_dirs %} \
	-L{{ link_dir }}
{%- endfor %}
{%- for link_lib in ctx.cfg.ccargs.link_libs %} \
	-l{{ link_lib }}
{%- endfor %}

EXTRA_CXXFLAGS = \
	-I$(CURDIR)
{%- for inc_dir in ctx.cfg.ccargs.inc_dirs %} \
	-I{{ inc_dir }}
{%- endfor %}

{%- if ctx.cfg.prof %}
EXTRA_CXXFLAGS += -DPROFILE
{%- endif %}

ifneq ($(CONDA_PREFIX),)
EXTRA_CXXFLAGS += -I$(CONDA_PREFIX)/include
LDFLAGS += -L$(CONDA_PREFIX)/lib
endif

sim: $(objs)
	$(CXX) $^ -o $@ $(LDFLAGS) $(LDLIBS)

%.cc.o: %.cc {{ ctx.smap.decl_h }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $(CPPFLAGS) -o $@ $<

{%- for extra in ctx.smap.extra_cpp %}
{{ ctx.smap.extra_obj(extra) }}.o: {{ extra }}
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $(CPPFLAGS) $(EXTRA_CXXFLAGS) -o $@ $<
{%- endfor %}
