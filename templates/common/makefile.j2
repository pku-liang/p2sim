CXX = clang++
CXXFLAGS += -pthread -mavx2 -std=c++20
LDFLAGS += -fuse-ld=lld -pthread -g

{%- if !ctx.cfg.ccargs.debug %}
CXXFLAGS += -O2
{%- endif %}

objs = \
	objs/{{ ctx.smap.impl_cc() }}.o
{%- for file in ctx.iter_all_group_files() %} \
	objs/{{ file }}.o
{%- endfor %}
{%- for extra in ctx.smap.extra_cpp %} \
	objs/{{ ctx.smap.extra_obj(extra) }}.o
{%- endfor %}

LDFLAGS +=
{%- for link_dir in ctx.cfg.ccargs.link_dirs %} \
	-L{{ link_dir }}
{%- endfor %}
{%- for link_lib in ctx.cfg.ccargs.link_libs %} \
	-l{{ link_lib }}
{%- endfor %}

EXTRA_CXXFLAGS = \
	-I$(CURDIR)/src \
	-DCURDIR="\"$(CURDIR)\""
{%- for inc_dir in ctx.cfg.ccargs.inc_dirs %} \
	-I{{ inc_dir }}
{%- endfor %}
{%- for define in ctx.cfg.ccargs.defines %} \
	-D{{ define }}
{%- endfor %}

ifneq ($(CONDA_PREFIX),)
EXTRA_CXXFLAGS += -I$(CONDA_PREFIX)/include
LDFLAGS += -L$(CONDA_PREFIX)/lib
endif

sim: $(objs)
	$(CXX) $^ -o $@ $(LDFLAGS) $(LDLIBS)

objs/%.cc.o: src/%.cc src/{{ ctx.smap.decl_h() }}
	@mkdir -p objs
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $(CPPFLAGS) -o $@ $<

{%- for extra in ctx.smap.extra_cpp %}
objs/{{ ctx.smap.extra_obj(extra) }}.o: {{ extra }}
	@mkdir -p objs
	$(CCACHE) $(CXX) -c $(CFLAGS) $(CXXFLAGS) $(CPPFLAGS) $(EXTRA_CXXFLAGS) -o $@ $<
{%- endfor %}
