{%- set decl_name = "S" ~ design.name -%}
{%- set impl_name = "S" ~ design.name ~ "Impl" -%}
{%- import "bitset-actmask.cpp.j2" as actset -%}

#include "{{ decl_name }}.h"
#include "{{ impl_name }}.h"

{%- for state in design.states %}
{%- if state.kind == StateKind::Input %}
void {{ impl_name }}::set_{{ state.name }}({{ state.width | int_ty }} data) {
    {{ state.width | int_ty }} {{ state.name }}$old = {{ state.name }};
    {{ state.name }} = data;
    bool cond = {{ state.name }} != {{ state.name }}$old;
    {% call actset::activates("cond", &state.acts) %}
}
void {{ decl_name }}::set_{{ state.name }}({{ state.width | int_ty }} data) {
    impl->set_{{ state.name }}(data);
}
{%- endif %}
{%- if state.kind == StateKind::Output %}
{{ state.width | int_ty }} {{ decl_name }}::get_{{ state.name }}() {
    return impl->{{ state.name }};
}
{%- endif %}
{%- if state.kind == StateKind::Memory %}
void * {{ decl_name }}::get_{{ state.name }}() {
    return (void*)&impl->{{ state.name }};
}
{%- endif %}
{%- endfor %}

void {{ decl_name }}::step() {
    impl->step();
}

void {{ impl_name }}::step() {
{%- for reset in design.resets %}
    reset_{{ reset.id }}();
{%- endfor %}
{%- for p in (0..design.logics.len()).step_by(*(cfg.act_pack as usize)) %}
    {%- set act_idx = p / cfg.act_pack as usize %}
    if(__act_mask[{{ act_idx }}]) {
    {%- for i in p..(p + cfg.act_pack as usize).min(design.logics.len()) %}
        if(__act_mask[{{ act_idx }}] & (1ull << {{ i - p }})) {
            __act_mask[{{ act_idx }}] &= ~(1ull << {{ i - p }});
            logic_{{ design.logics[i].id.0 }}();
        }
    {%- endfor %}
    }
{%- endfor %}
}