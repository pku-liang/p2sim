#include "{{ ctx.smap.decl_h }}"

void {{ ctx.name }}::reset_{{ group_id }}() {
{%- for (id, reset) in ctx.iter_reset_group(*group_id) %}
    if({{ ctx.name(reset.reset) }}) [[unlikely]] {
    {%- for inst in reset.insts %}
        {%- match inst %}
        {%- when Inst::CppCode(code) %}
        {{ code }}
        {%- when _ %}
        {%- endmatch%}
    {%- endfor %}
    {%- for act in reset.acts %}
    __act_mask[{{ act.0 / ctx.cfg.act_mask_width }}] |= 1 << {{ act.0 % ctx.cfg.act_mask_width }};
    {%- endfor %}
    }
{%- endfor %}
}
