#include "{{ ctx.smap.decl_h }}"

void {{ ctx.name }}::step_{{ group_id }}() {
    {%- for (grp, iter) in ctx.iter_block_act_group(*group_id) %}
    {% if !ctx.cfg.diff_test %}
    if(__act_mask[{{ grp }}])
    {%- endif %}
    {
        {%- for (id, block) in iter %}
        {%- if !block.always  %}
        if(__act_mask[{{ id.0 / ctx.cfg.act_mask_width }}] & ((act_t)1 << {{ id.0 % ctx.cfg.act_mask_width }}))
        {%- endif %}
        {
            __act_mask[{{ id.0 / ctx.cfg.act_mask_width }}] &= ~((act_t)1 << {{ id.0 % ctx.cfg.act_mask_width }});
            {%- for inst in block.insts %}
            {%- match inst %}
            {%- when Inst::CppCode(code) %}
            {{ code }}
            {%- when Inst::Read{ name, sid } %}
            {%- when Inst::WritePre{ name, sid } %}
            {%- if !ctx.is_array(sid) %}
            {{ ctx.int_ty(sid) }} {{ name }}$OLD${{ sid.0 }} = {{ ctx.name(sid) }};
            {%- endif %}
            {%- when Inst::WritePost{ name, sid, .. } %}
            {%- if !ctx.is_array(sid) %}
            bool {{ name }}$CHG = {{ name }}$OLD${{ sid.0 }} != {{ ctx.name(sid) }};
            {%- else %}
            bool {{ name }}$CHG = true;
            {%- endif %}
            {%- if ctx.act_map(sid).len() < 5 %}
            {%- for blk_id in ctx.act_map(sid) %}
            __act_mask[{{ blk_id.0 / ctx.cfg.act_mask_width }}] |= (act_t){{ name }}$CHG << {{ blk_id.0 % ctx.cfg.act_mask_width }};
            {%- endfor %}
            {%- else %}
            if({{ name }}$CHG) {
                {%- for blk_id in ctx.act_map(sid) %}
                __act_mask[{{ blk_id.0 / ctx.cfg.act_mask_width }}] |= (act_t)1 << {{ blk_id.0 % ctx.cfg.act_mask_width }};
                {%- endfor %}
            }
            {%- endif %}
            {%- endmatch %}
            {%- endfor %}
        }
        {%- endfor %}
    }
    {%- endfor %}
}
