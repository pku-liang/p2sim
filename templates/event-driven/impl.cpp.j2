#include "{{ ctx.smap.decl_h }}"

{%- import "common/gprintf.cpp.j2" as gprintf -%}

{%- call gprintf::emit_gprintf(ctx.name ~ "Syms::gprintf") %}

void {{ ctx.name }}::step() {
{%- if ctx.cfg.prof %}
    union {
        uint64_t val64[4];
        __m256i_u val;
    } val;
    val.val64[0] = __rng();
    val.val64[1] = __rng();
    val.val64[2] = __rng();
    val.val64[3] = __rng();
    __act_hash_cur_cycle[0] = val.val;
    val.val64[0] = __rng();
    val.val64[1] = __rng();
    val.val64[2] = __rng();
    val.val64[3] = __rng();
    __act_hash_cur_cycle[1] = val.val;
{%- endif %}
{%- for grp_id in 0..ctx.reset_groups.len() %}
    reset_{{ grp_id }}();
{%- endfor %}
{%- for grp_id in 0..ctx.block_groups.len() %}
    step_{{ grp_id }}();
{%- endfor %}
    __cycles++;
}

void {{ ctx.name }}::init() {
    memset(__syms_start, 0, __syms_end - __syms_start);
    memset(__act_mask, 0xff, sizeof(__act_mask));
    {%- if ctx.cfg.diff_test %}
    diff = new {{ ctx.name }}Diff();
    memset(diff->__syms_start, 0, diff->__syms_end - diff->__syms_start);
    {%- endif %}
    {%- if ctx.cfg.prof %}
    memset(__act_hash, 0xff, sizeof(__act_hash));
    {%- endif %}
}

{%- for state in ctx.iter_ext_state() %}
{{ ctx.int_ty(state) }} {{ ctx.name }}::get_{{ ctx.name(state) }}() {
    return {{ ctx.name(state) }};
}
void {{ ctx.name }}::set_{{ ctx.name(state) }}({{ ctx.int_ty(state) }} __value) {
    {{ ctx.name(state) }} = __value;
    {%- if ctx.cfg.diff_test %}
    diff->{{ ctx.name(state) }} = __value;
    {%- endif %}
    {%- for blk_id in ctx.act_map(state) %}
    __act_mask[{{ blk_id.0 / ctx.cfg.act_mask_width }}] |= 1 << {{ blk_id.0 % ctx.cfg.act_mask_width }};
    {%- endfor %}
}
{%- endfor %}

{%- if ctx.cfg.prof %}
bool {{ ctx.name }}::dump_act_info(const char * filename) {
    FILE * f = fopen(filename, "w");
    if(!f) return false;
    uint64_t block_count = {{ ctx.blocks.len() }};
    fwrite(&block_count, sizeof(uint64_t), 1, f);
    fwrite(__act_count, sizeof(uint32_t), {{ ctx.blocks.len() }}, f);
    fwrite(&block_count, sizeof(uint64_t), 1, f);
    fwrite(__act_hash, sizeof(prof_hash_t), {{ ctx.blocks.len() }}, f);
    fclose(f);
    return true;
}
{%- endif %}
