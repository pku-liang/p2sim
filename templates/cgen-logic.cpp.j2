{%- import "bitset-actmask.cpp.j2" as actset -%}

#include "{{ file_map.impl_h }}"

{%- macro emit_inst(inst, own_id) %}
    {%- match inst %}
        {%- when Inst::Raw(inst) %}
        {{ inst }}
        {%- when _ -%}
        {# {%- when Inst::Save(_, name, false, width) %}
        {%- when Inst::Save(_, name, true, width) %}
            {{ width | int_ty }} {{ name }}$old = {{ name }};
        {%- when Inst::Act(_, name, true, ids) %}
            {%- set cond = name ~ "$cond" %}
            bool {{ cond }} = {{ name }}$old != {{ name }};
            {%- call actset::activates(cond, ids, own_id) %}
        {%- when Inst::Act(_, _, false, ids) %}
            {%- call actset::activates("1ull", ids, own_id) %} #}
    {%- endmatch %}
{%- endmacro %}

{%- if logics.len() > 0 %}
void {{ impl_name }}::substep_{{ step_id }}() {
{%- for (pack, groups) in self::iter_logic_groups(logics, *cfg.act_pack) %}
    {%- for logic in groups %}
    {
        {%- for inst in logic.insts %}
        {%- call emit_inst(inst, logic.id.0) %}
        {%- endfor %}
    }
    {%- endfor %}
{%- endfor %}
}
{%- endif %}

{%- if resets.len() > 0 %}
void {{ impl_name }}::subreset_{{ step_id }}() {
{%- for reset in resets %}
    {# if ({{ reset.reset }}) [[unlikely]]  #}
    {
    {# {%- call actset::activates("1ull", &reset.acts, u32::MAX) %} #}
    {%- for inst in reset.insts %}
    {%- call emit_inst(inst, u32::MAX) %}
    {%- endfor %}
    }
{%- endfor %}
}
{%- endif %}
