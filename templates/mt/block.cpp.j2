#include "{{ ctx.smap.thread_h(*part_id) }}"

{%- let part = ctx.parts[part_id] %}
void {{ ctx.name }}_{{ part_id.0 }}::step_{{ group_id }}() {
    {%- if ctx.cfg.prof.minhash %}
    MH act_hash = cur_act_hash;
    {%- endif %}
    {%- for (grp, iter) in part.iter_block_act_group(*group_id) %}
    if(__act_mask[{{ grp }}])
    {
        {%- for (id, block) in iter %}
        {%- if block.pushes.is_none() %}
        {%- if !block.always %}
        if(__act_mask[{{ id.0 / ctx.cfg.act_mask_width }}] & ((act_t)1 << {{ id.0 % ctx.cfg.act_mask_width }}))
        {%- endif %}
        {
            {%- if ctx.cfg.prof.act_cnt %}
            prof.act_cnt[{{ id.0 }}]++;
            {%- endif %}
            {%- if ctx.cfg.prof.minhash %}
            prof.act_hash[{{ id.0 }}].update(act_hash);
            {%- endif %}
            // block {{ id.0 }}
            __act_mask[{{ id.0 / ctx.cfg.act_mask_width }}] &= ~((act_t)1 << {{ id.0 % ctx.cfg.act_mask_width }});
            {%- for inst in block.insts %}
            {%- match inst %}
            {%- when Inst::CppCode {inst: code, ..} %}
            {{ code }}
            {%- when Inst::WritePre { name, sid }%}
            {%- if !part.is_array(sid) %}
            {{ part.int_ty(sid) }} {{ name }}$OLD = {{ part.name(sid) }};
            {%- endif %}
            {%- when Inst::WritePost { name, sid, ..} %}
            {%- if !part.is_array(sid) %}
            bool {{ name }}$CHG = {{ name }}$OLD != {{ part.name(sid) }};
            {%- else %}
            bool {{ name }}$CHG = true;
            {%- endif %}
            {%- if part.act_map(sid).len() < 5 %}
            {%- for blk_id in part.act_map(sid) %}
            __act_mask[{{ blk_id.0 / ctx.cfg.act_mask_width }}] |= (act_t){{ name }}$CHG << {{ blk_id.0 % ctx.cfg.act_mask_width }}; // activate {{ blk_id.0 }}
            {%- endfor %}
            {%- else %}
            if({{ name }}$CHG) {
                {%- for blk_id in part.act_map(sid) %}
                __act_mask[{{ blk_id.0 / ctx.cfg.act_mask_width }}] |= (act_t)1 << {{ blk_id.0 % ctx.cfg.act_mask_width }}; // activate {{ blk_id.0 }}
                {%- endfor %}
            }
            {%- endif %}
            {%- when _ %}
            {%- endmatch %}
            {%- endfor %}
        }
        {%- endif %}
        {%- endfor %}
    }
    {%- endfor %}
}
