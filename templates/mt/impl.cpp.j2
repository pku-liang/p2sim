static void pin_to_core(int core_id){
  cpu_set_t set;
  CPU_ZERO(&set);
  CPU_SET(core_id, &set);
  int err = pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
  if (err) { perror("pthread_setaffinity_np"); exit(1); }
  int now = sched_getcpu();
  if (now != core_id) {
    fprintf(stderr, "Warning: expected core %d but on %d\n", core_id, now);
  }
}

struct alignas(64) SpinBarrierFlag {
  std::atomic<bool> flag;
};

template<int N>
struct SpinBarrier {
  SpinBarrierFlag __flag_arrive[N] = {};
  SpinBarrierFlag __flag_wait[N] = {};
  void arrive(int id) {
    __flag_arrive[id].flag.store(true);
  }
  void wait(int id) {
    if(id == 0) {
      for(int i = 0; i < N; i++) {
        while(!__flag_arrive[i].flag.load()) {
          _mm_pause();
        }
        __flag_arrive[i].flag.store(false);
      }
      for(int i = 0; i < N; i++) {
        __flag_wait[i].flag.store(true);
      }
    }
    while(!__flag_wait[id].flag.load()) {
      _mm_pause();
    }
    __flag_wait[id].flag.store(false);
  }
  void arrive_and_wait(int id) {
    arrive(id);
    wait(id);
  }
};

#define CACHELINE_SIZE 64

template<typename T>
struct alignas(CACHELINE_SIZE) aligned_atomic {
  std::atomic<T> v {0};
  char pad[CACHELINE_SIZE - sizeof(std::atomic<T>)] {};
  aligned_atomic() = default;
  aligned_atomic(T val) : v(val) {}
  aligned_atomic(const aligned_atomic &r): v(r.v.load()), pad() {}
};

struct at_barrier {
  aligned_atomic<unsigned> arrive;
  aligned_atomic<unsigned> step;
  const int count;
  at_barrier(int count) : count(count), arrive(count), step(0) {}
  void arrive_and_wait(int i, int & local_epoch) noexcept {
    auto cur_step = step.v.load();
    if(!--arrive.v) {
      arrive.v = count;
      ++step.v;
    } else {
      while(step.v.load() == cur_step) {
        _mm_pause();
      }
    }
  }
};

uint64_t rdtsc() {
  unsigned aux;
  return __rdtscp(&aux);
}

void {{ ctx.name }}::step_mt(int cycles, int start_core) {
    at_barrier barrier({{ ctx.parts.len() }});
    std::vector<std::thread> threads;
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- let master = part_id.0 == 0 %}
    {%- set ref_obj = "ref_" ~ part_id.0 %}
    auto {{ ref_obj }} = &part_{{ part_id.0 }};
    threads.push_back(std::thread{
        [&, cycles, ref_{{ part_id.0 }}](){
            pin_to_core(start_core + {{ part_id.0 }});
            {%- if ctx.cfg.prof %}
            auto old_size = {{ ref_obj }}->__prof_counter.size();
            {{ ref_obj }}->__prof_counter.resize(old_size + cycles*6);
            {%- endif %}
            {%- if master %}
            auto start = std::chrono::high_resolution_clock::now();
            {%- endif %}
            int local_epoch = 0;
            for(int i = 0; i < cycles; i++) {
                {%- if ctx.cfg.prof %}
                uint64_t t1 = rdtsc();
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                uint64_t t2 = rdtsc();
                {{ ref_obj }}->pull();
                uint64_t t3 = rdtsc();
                {{ ref_obj }}->step();
                uint64_t t4 = rdtsc();
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                uint64_t t5 = rdtsc();
                {{ ref_obj }}->push();
                uint64_t t6 = rdtsc();
                {{ ref_obj }}->__prof_counter[old_size + i*6 + 0] = t1;
                {{ ref_obj }}->__prof_counter[old_size + i*6 + 1] = t2;
                {{ ref_obj }}->__prof_counter[old_size + i*6 + 2] = t3;
                {{ ref_obj }}->__prof_counter[old_size + i*6 + 3] = t4;
                {{ ref_obj }}->__prof_counter[old_size + i*6 + 4] = t5;
                {{ ref_obj }}->__prof_counter[old_size + i*6 + 5] = t6;
                {%- else %}
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                {{ ref_obj }}->pull();
                {{ ref_obj }}->step();
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                {{ ref_obj }}->push();
                {%- endif %}
                {%- if master %}
                if(i % 100000 == 0) {
                  auto current = std::chrono::high_resolution_clock::now();
                  auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(current - start).count();
                  std::cout << "cycle=" << i << ", freq=" << i * 1.0 / duration << " kHz\n";
                }
                {%- endif %}
            }
        }
    });
    {%- endfor %}
    for(auto & thread: threads) {
        thread.join();
    }
}

bool {{ ctx.name }}::dump_prof_counter(const char * filename) {
    FILE * f = fopen(filename, "wb");
    if(!f) return false;
    uint64_t part_count = {{ ctx.parts.len() }};
    fwrite(&part_count, sizeof(uint64_t), 1, f);
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set ref_obj = "ref_" ~ part_id.0 %}
    auto {{ ref_obj }} = &part_{{ part_id.0 }};
    uint64_t prof_counter_size_{{ part_id.0 }} = {{ ref_obj }}->__prof_counter.size();
    fwrite(&prof_counter_size_{{ part_id.0 }}, sizeof(uint64_t), 1, f);
    fwrite({{ ref_obj }}->__prof_counter.data(), sizeof(uint64_t), {{ ref_obj }}->__prof_counter.size(), f);
    {%- endfor %}
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set ref_obj = "ref_" ~ part_id.0 %}
    fwrite(&part_count, sizeof(uint64_t), 1, f);
    uint64_t act_cnt_size_{{ part_id.0 }} = {{ part.blocks.len() }};
    fwrite(&act_cnt_size_{{ part_id.0 }}, sizeof(uint64_t), 1, f);
    fwrite({{ ref_obj }}->__act_cnt, sizeof(uint32_t), {{ part.blocks.len() }}, f);
    {%- endfor %}
    fclose(f);
    return true;
}

