bool {{ ctx.name }}::dump_prof(const char * filename) {
  FILE * f = fopen(filename, "wb");
  if(!f) return false;
  uint32_t mh_ver_bits = {{ ctx.mh_ver.dtype_bits }};
  uint32_t mh_ver_width = {{ ctx.mh_ver.width }};
  fwrite(&mh_ver_bits, sizeof(uint32_t), 1, f);
  fwrite(&mh_ver_width, sizeof(uint32_t), 1, f);
  uint64_t part_count = {{ ctx.parts.len() }};
  fwrite(&part_count, sizeof(uint64_t), 1, f);
  {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
  {%- set cls = ctx.name ~ "_" ~ part_id.0 %}
  part_{{ part_id.0 }}.prof->dump(f);
  {%- endfor %}
  {%- set record_name = ctx.name ~ "_blk_record" %}
  fwrite(&{{ record_name }}_length, sizeof(uint64_t), 1, f);
  fwrite({{ record_name }}, sizeof(uint32_t), {{ record_name }}_size, f);
  fclose(f);
  return true;
}

