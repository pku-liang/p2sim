void {{ cls }}::pull() {
{%- for (local_id, ty, mirror) in ctx.iter_mirrors(part_id) %}
    {%- if ty == AccessType::ReadOnly %}
    {%- if !part.is_array(local_id) %}
    bool {{ part.name(local_id) }}$CHG = this->{{ part.name(local_id) }} != shared->{{ mirror.name }};
    {%- else %}
    bool {{ part.name(local_id) }}$CHG = memcmp(this->{{ part.name(local_id) }}, shared->{{ mirror.name }}, sizeof({{ part.name(local_id) }})) != 0;
    {%- endif %}
    {%- endif %}
{%- endfor %}
{%- for (local_id, ty, mirror) in ctx.iter_mirrors(part_id) %}
    {%- if ty == AccessType::ReadOnly %}
    {%- if part.act_map(local_id).len() < 5 %}
    {%- for act in part.act_map(local_id) %}
    __act_mask[{{ act.0 / ctx.cfg.act_mask_width }}] |= (act_t){{ part.name(local_id) }}$CHG << {{ act.0 % ctx.cfg.act_mask_width }}; // activate {{ act.0 }}
    {%- endfor %}
    {%- else %}
    if({{ part.name(local_id) }}$CHG) {
      {%- for blk_id in part.act_map(local_id) %}
      __act_mask[{{ blk_id.0 / ctx.cfg.act_mask_width }}] |= (act_t)1 << {{ blk_id.0 % ctx.cfg.act_mask_width }}; // activate {{ blk_id.0 }}
      {%- endfor %}
    }
    {%- endif %}
    {%- endif %}
{%- endfor %}
{%- for (local_id, ty, mirror) in ctx.iter_mirrors(part_id) %}
    {%- if ty == AccessType::ReadOnly %}
    {%- if !part.is_array(local_id) %}
    this->{{ part.name(local_id) }} = shared->{{ mirror.name }};
    {%- else %}
    memcpy(this->{{ part.name(local_id) }}, shared->{{ mirror.name }}, sizeof({{ part.name(local_id) }}));
    {%- endif %}
    {%- endif %}
{%- endfor %}
}

void {{ cls }}::push() {
{%- for (local_id, ty, mirror) in ctx.iter_mirrors(part_id) %}
    {%- if ty.has_write() %}
    {%- if !part.is_array(local_id) %}
    shared->{{ mirror.name }} = this->{{ part.name(local_id) }};
    {%- else %}
    memcpy(shared->{{ mirror.name }}, this->{{ part.name(local_id) }}, sizeof({{ part.name(local_id) }}));
    {%- endif %}
    {%- endif %}
{%- endfor %}
}

