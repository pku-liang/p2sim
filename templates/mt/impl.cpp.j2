void {{ ctx.name }}::init() {
    shared = new {{ ctx.name }}_shared;
    memset(shared, 0, sizeof({{ ctx.name }}_shared));
    memset(shared->__s_act_mask, 0xff, sizeof(shared->__s_act_mask));
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    part_{{ part_id.0 }}.init(shared);
    {%- endfor %}
    {%- for lm in ctx.large_mem %}
    {{ lm.state.name }} = part_{{ lm.part_id.0 }}.{{ lm.state.name }};
    {%- endfor %}
}

void {{ ctx.name }}::step(int cycles) {
  while(cycles--) {
{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    part_{{ part_id.0 }}.pull();
    part_{{ part_id.0 }}.step();
{%- endfor %}
{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    part_{{ part_id.0 }}.push();
{%- endfor %}
  }
}

