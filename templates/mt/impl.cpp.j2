static void pin_to_core(int core_id){
  cpu_set_t set;
  CPU_ZERO(&set);
  CPU_SET(core_id, &set);
  int err = pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
  if (err) { perror("pthread_setaffinity_np"); exit(1); }
  int now = sched_getcpu();
  if (now != core_id) {
    fprintf(stderr, "Warning: expected core %d but on %d\n", core_id, now);
  }
}

struct alignas(64) SpinBarrierFlag {
  std::atomic<bool> flag;
};

template<int N>
struct SpinBarrier {
  SpinBarrierFlag __flag_arrive[N] = {};
  SpinBarrierFlag __flag_wait[N] = {};
  void arrive(int id) {
    __flag_arrive[id].flag.store(true);
  }
  void wait(int id) {
    if(id == 0) {
      for(int i = 0; i < N; i++) {
        while(!__flag_arrive[i].flag.load()) {
          _mm_pause();
        }
        __flag_arrive[i].flag.store(false);
      }
      for(int i = 0; i < N; i++) {
        __flag_wait[i].flag.store(true);
      }
    }
    while(!__flag_wait[id].flag.load()) {
      _mm_pause();
    }
    __flag_wait[id].flag.store(false);
  }
  void arrive_and_wait(int id) {
    arrive(id);
    wait(id);
  }
};

void {{ ctx.name }}::step_mt(int cycles, int start_core) {
    SpinBarrier<{{ ctx.parts.len() }}> barrier;
    std::vector<std::thread> threads;
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- let master = part_id.0 == 0 %}
    {%- set ref_obj = "ref_" ~ part_id.0 %}
    auto {{ ref_obj }} = &part_{{ part_id.0 }};
    threads.push_back(std::thread{
        [&, cycles, ref_{{ part_id.0 }}](){
            pin_to_core(start_core + {{ part_id.0 }});
            auto old_size = {{ ref_obj }}->__prof_counter.size();
            {{ ref_obj }}->__prof_counter.reserve(old_size + cycles*6+1);
            {%- if master %}
            clock_t prev = clock();
            {%- endif %}
            for(int i = 0; i < cycles; i++) {
                unsigned long long t1 = __rdtsc();
                barrier.arrive_and_wait({{ part_id.0 }});
                unsigned long long t2 = __rdtsc();
                {{ ref_obj }}->pull();
                unsigned long long t3 = __rdtsc();
                {{ ref_obj }}->step();
                unsigned long long t4 = __rdtsc();
                barrier.arrive_and_wait({{ part_id.0 }});
                unsigned long long t5 = __rdtsc();
                {{ ref_obj }}->push();
                unsigned long long t6 = __rdtsc();
                {{ ref_obj }}->__prof_counter.push_back(t1);
                {{ ref_obj }}->__prof_counter.push_back(t2);
                {{ ref_obj }}->__prof_counter.push_back(t3);
                {{ ref_obj }}->__prof_counter.push_back(t4);
                {{ ref_obj }}->__prof_counter.push_back(t5);
                {{ ref_obj }}->__prof_counter.push_back(t6);
                {%- if master %}
                if(i % 100000 == 0) {
                    clock_t time = clock();
                    printf("cycle=%d, freq=%lf kHz\n", i, i * 1.0 / (time - prev) * CLOCKS_PER_SEC / 1000);
                }
                {%- endif %}
            }
        }
    });
    {%- endfor %}
    for(auto & thread: threads) {
        thread.join();
    }
}

bool {{ ctx.name }}::dump_prof_counter(const char * filename) {
    FILE * f = fopen(filename, "wb");
    if(!f) return false;
    uint64_t part_count = {{ ctx.parts.len() }};
    fwrite(&part_count, sizeof(uint64_t), 1, f);
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set ref_obj = "ref_" ~ part_id.0 %}
    auto {{ ref_obj }} = &part_{{ part_id.0 }};
    fwrite({{ ref_obj }}->__prof_counter.data(), sizeof(unsigned long long), {{ ref_obj }}->__prof_counter.size(), f);
    {%- endfor %}
    fclose(f);
    return true;
}

void {{ ctx.name }}::print_stats() {
    std::cerr << "shared_size=" << sizeof({{ ctx.name }}_shared) << std::endl;
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    std::cerr << "part_size[{{ part_id.0 }}]=" << sizeof({{ ctx.name }}_{{ part_id.0 }}) << std::endl;
    {%- endfor %}
}