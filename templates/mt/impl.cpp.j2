void {{ ctx.name }}::init() {
    memset(&shared, 0, sizeof({{ ctx.name }}_shared));
    memset(shared.__s_act_mask, 0xff, sizeof(shared.__s_act_mask));
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    part_{{ part_id.0 }}.init(&shared);
    {%- endfor %}
    {%- for lm in ctx.large_mem %}
    {{ lm.state.name }} = part_{{ lm.part_id.0 }}.{{ lm.state.name }};
    {%- endfor %}
}

void {{ ctx.name }}::step() {
{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    part_{{ part_id.0 }}.pull();
    part_{{ part_id.0 }}.step();
{%- endfor %}
{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    part_{{ part_id.0 }}.push();
{%- endfor %}
}

{%- for s in ctx.ext_states %}
{%- let first_id = s.acts.first().unwrap().0 %}
{{ s.width | int_ty }} {{ ctx.name }}::get_{{ s.name }}() {
    return shared.{{ ctx.name(first_id) }};
}
void {{ ctx.name }}::set_{{ s.name }}({{ s.width | int_ty }} value) {
    {%- for (sid, act_id) in s.acts %}
    shared.{{ ctx.name(sid) }} = value;
    shared.__s_act_mask[{{ act_id as u32 / ctx.cfg.act_mask_width }}] |= (1 << {{ act_id as u32 % ctx.cfg.act_mask_width }});
    {%- endfor %}
}
{%- endfor %}

static void pin_to_core(int core_id){
  cpu_set_t set;
  CPU_ZERO(&set);
  CPU_SET(core_id, &set);
  int err = pthread_setaffinity_np(pthread_self(), sizeof(set), &set);
  if (err) { perror("pthread_setaffinity_np"); exit(1); }
  int now = sched_getcpu();
  if (now != core_id) {
    fprintf(stderr, "Warning: expected core %d but on %d\n", core_id, now);
  }
}

#define CACHELINE_SIZE 64

template<typename T>
struct alignas(CACHELINE_SIZE) aligned_atomic {
  std::atomic<T> v {0};
  char pad[CACHELINE_SIZE - sizeof(std::atomic<T>)] {};
  aligned_atomic() = default;
  aligned_atomic(T val) : v(val) {}
  aligned_atomic(const aligned_atomic &r): v(r.v.load()), pad() {}
};

struct at_barrier {
  aligned_atomic<unsigned> arrive;
  aligned_atomic<unsigned> step;
  const int count;
  at_barrier(int count) : count(count), arrive(count), step(0) {}
  void arrive_and_wait(int i, int & local_epoch) noexcept {
    auto cur_step = step.v.load();
    if(!--arrive.v) {
      arrive.v = count;
      ++step.v;
    } else {
      while(step.v.load() == cur_step) {
        _mm_pause();
      }
    }
  }
};

inline uint64_t rdtsc() {
  unsigned aux;
  return __rdtscp(&aux);
}

void {{ ctx.name }}::step_mt(int cycles, int start_core) {
    at_barrier barrier({{ ctx.parts.len() }});
    std::vector<std::thread> threads;
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- let master = part_id.0 == 0 %}
    {%- set ref_obj = "ref_" ~ part_id.0 %}
    auto {{ ref_obj }} = &part_{{ part_id.0 }};
    threads.push_back(std::thread{
        [&, cycles, ref_{{ part_id.0 }}](){
            pin_to_core(start_core + {{ part_id.0 }});
            {%- if ctx.cfg.prof %}
            auto prof = {{ ref_obj }}->get_prof();
            auto old_size = prof->rdtsc_ticks.size();
            prof->rdtsc_ticks.resize(old_size + cycles*6);
            {%- endif %}
            {%- if master %}
            auto start = std::chrono::high_resolution_clock::now();
            {%- endif %}
            int local_epoch = 0;
            for(int i = 0; i < cycles; i++) {
                {%- if ctx.cfg.prof %}
                uint64_t t1 = rdtsc();
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                uint64_t t2 = rdtsc();
                {{ ref_obj }}->pull();
                uint64_t t3 = rdtsc();
                {{ ref_obj }}->step();
                uint64_t t4 = rdtsc();
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                uint64_t t5 = rdtsc();
                {{ ref_obj }}->push();
                uint64_t t6 = rdtsc();
                prof->rdtsc_ticks[old_size + i*6 + 0] = t1;
                prof->rdtsc_ticks[old_size + i*6 + 1] = t2;
                prof->rdtsc_ticks[old_size + i*6 + 2] = t3;
                prof->rdtsc_ticks[old_size + i*6 + 3] = t4;
                prof->rdtsc_ticks[old_size + i*6 + 4] = t5;
                prof->rdtsc_ticks[old_size + i*6 + 5] = t6;
                {%- else %}
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                {{ ref_obj }}->pull();
                {{ ref_obj }}->step();
                barrier.arrive_and_wait({{part_id.0}}, local_epoch);
                {{ ref_obj }}->push();
                {%- endif %}
                {%- if master %}
                if(i % 100000 == 0) {
                  auto current = std::chrono::high_resolution_clock::now();
                  auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(current - start).count();
                  std::cout << "cycle=" << i << ", freq=" << i * 1.0 / duration << " kHz\n";
                }
                {%- endif %}
            }
        }
    });
    {%- endfor %}
    for(auto & thread: threads) {
        thread.join();
    }
}

{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
{%- set cls = ctx.name ~ "_" ~ part_id.0 %}
void {{ cls }}_prof::dump(FILE * f) {
    uint64_t act_cnt_size = {{ part.blocks.len() }};
    fwrite(&act_cnt_size, sizeof(uint64_t), 1, f);
    fwrite(act_cnt, sizeof(uint32_t), act_cnt_size, f);
    uint64_t rdtsc_ticks_size = rdtsc_ticks.size();
    fwrite(&rdtsc_ticks_size, sizeof(uint64_t), 1, f);
    fwrite(rdtsc_ticks.data(), sizeof(uint64_t), rdtsc_ticks_size, f);
}
{%- endfor %}

bool {{ ctx.name }}::dump_prof(const char * filename) {
    FILE * f = fopen(filename, "wb");
    if(!f) return false;
    uint64_t part_count = {{ ctx.parts.len() }};
    fwrite(&part_count, sizeof(uint64_t), 1, f);
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set cls = ctx.name ~ "_" ~ part_id.0 %}
    part_{{ part_id.0 }}.get_prof()->dump(f);
    {%- endfor %}
    fclose(f);
    return true;
}
