#pragma once

{% include "common/decl.h.j2" %}

{# #include "{{ ctx.smap.minhash_h() }}" #}

{%- for ext in ctx.ext_fns %}
{{ ext }}
{%- endfor %}

struct alignas(64) {{ ctx.name }}_shared {
    using act_t = uint{{ ctx.cfg.act_mask_width }}_t;
    act_t __s_act_mask[{{ (ctx.shared_acts as u32 + ctx.cfg.act_mask_width - 1) / ctx.cfg.act_mask_width }}];

{%- for state in ctx.shared %}
    {%- if !state.is_disabled %}
    {{ state.width | int_ty }} {{ state.name }}
    {%- for dim in state.dims -%} [{{ dim }}] {%- endfor -%};
    {%- endif %}
{%- endfor %}
};

struct prof_record {
    static constexpr int AVG_ACT_SIZE = 4096;
    uint8_t avg_act[AVG_ACT_SIZE];
    inline static prof_record default_value() {
        prof_record res;
        res.reset();
        return res;
    }
    inline void reset() {
        memset(avg_act, 0, sizeof(avg_act));
    }
    inline void update(int cur_cycle) {
        if(cur_cycle && cur_cycle % 256 == 0) {
            avg_act[cur_cycle / 256]++;
        }
    }
};

struct prof_obj {
    std::vector<uint32_t> act_cnt;
    std::vector<prof_record> act_hash;
    std::vector<uint64_t> rdtsc_ticks;
    void init(int num_blocks);
    void dump(FILE * f);
};

{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
{%- set cls = ctx.name ~ "_" ~ part_id.0 %}
struct {{ cls }};
struct {{ cls }}_decl {
    {{ cls }} * impl;
    void step();
    void init({{ ctx.name }}_shared *);
    void pull();
    void push();
    prof_obj * get_prof();
    {%- for lm in ctx.large_mem %}
    {%- if lm.part_id == part_id %}
    void * {{ lm.state.name }};
    {%- endif %}
    {%- endfor %}
    {%- if ctx.cfg.prof %}
    int * cur_cycle;
    {%- endif %}
};
{%- endfor %}

struct alignas(64) {{ ctx.name }} {
    {{ ctx.name }}_shared shared;
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set cls = ctx.name ~ "_" ~ part_id.0 %}
    {{ cls }}_decl part_{{ part_id.0 }};
    {%- endfor %}
    void step();
    void init();
    void step_mt(int cycles, int start_core=0);
    bool dump_prof(const char * filename);

    {%- for s in ctx.ext_states %}
    {%- let first_id = s.acts.first().unwrap().0 %}
    {{ s.width | int_ty }} get_{{ s.name }}();
    void set_{{ s.name }}({{ s.width | int_ty }} value);
    {%- endfor %}

    {%- for lm in ctx.large_mem %}
    void * {{ lm.state.name }};
    {%- endfor %}
};