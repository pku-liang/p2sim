#ifndef __{{ ctx.name }}_H__
#define __{{ ctx.name }}_H__

#include "{{ ctx.smap.minhash_h() }}"

{%- for ext in ctx.ext_fns %}
{{ ext }}
{%- endfor %}

struct alignas(64) {{ ctx.name }}_shared;

struct prof_obj {
    uint64_t rdtsc_avg[6];
    std::vector<uint32_t> act_cnt;
    std::vector<MH> act_hash;
    std::vector<uint64_t> rdtsc_ticks;
    void init(int num_blocks);
    void dump(FILE * f);
};

{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
{%- set cls = ctx.name ~ "_" ~ part_id.0 %}
struct {{ cls }};
struct {{ cls }}_decl {
    {{ cls }}* impl = nullptr;
    void init({{ ctx.name }}_shared * shared);
    void step();
    {%- if ctx.cfg.spec_sim %}
    void step_spec();
    void step_repair();
    void advance_epoch();
    {%- endif %}
    void pull({{ ctx.name }}_shared * shared);
    void push({{ ctx.name }}_shared * shared);
    ~{{ cls }}_decl();
    prof_obj * prof;
    {%- for lm in ctx.large_mem %}
    {%- if lm.part_id == part_id %}
    void * {{ lm.state.name }};
    {%- endif %}
    {%- endfor %}
    MH * cur_act_hash;
};
{%- endfor %}

struct alignas(64) {{ ctx.name }} {
    {{ ctx.name }}_shared * shared = nullptr;
    {%- if ctx.cfg.spec_sim %}
    {{ ctx.name }}_shared * shared_alt = nullptr;
    int shared_epoch = 0;
    {%- endif %}
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set cls = ctx.name ~ "_" ~ part_id.0 %}
    {{ cls }}_decl part_{{ part_id.0 }};
    {%- endfor %}

    ~{{ ctx.name }}();
    void init();
    void step(int cycles=1);
    void step_mt(int cycles=1);
    bool dump_prof(const char * filename);

    {%- for s in ctx.ext_states %}
    {%- let first_id = s.acts.first().unwrap().0 %}
    {{ s.width | int_ty }} get_{{ s.name }}();
    void set_{{ s.name }}({{ s.width | int_ty }} value);
    {%- endfor %}

    {%- for lm in ctx.large_mem %}
    void * {{ lm.state.name }};
    {%- endfor %}
};

#endif
