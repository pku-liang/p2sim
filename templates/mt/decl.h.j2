#pragma once

{% include "common/decl.h.j2" %}
#include <immintrin.h>

{%- for ext in ctx.ext_fns %}
{{ ext }}
{%- endfor %}

struct alignas(64) {{ ctx.name }}_shared {
    using act_t = uint{{ ctx.cfg.act_mask_width }}_t;
    act_t __s_act_mask[{{ (ctx.shared_acts as u32 + ctx.cfg.act_mask_width - 1) / ctx.cfg.act_mask_width }}];

{%- for state in ctx.shared %}
    {%- if !state.is_disabled %}
    {{ state.width | int_ty }} {{ state.name }}
    {%- for dim in state.dims -%} [{{ dim }}] {%- endfor -%};
    {%- endif %}
{%- endfor %}
};

{%- for (part_id, part) in ctx.parts.enumerate_ids() %}
{%- set cls = ctx.name ~ "_" ~ part_id.0 %}
struct {{ cls }};
struct {{ cls }}_prof {
    uint32_t act_cnt[{{ part.blocks.len() }}];
    std::vector<uint64_t> rdtsc_ticks;
    inline void init() {
        memset(act_cnt, 0, sizeof(act_cnt));
        rdtsc_ticks.clear();
    }
    void dump(FILE * f);
};
struct {{ cls }}_decl {
    {{ cls }} * impl;
    void step();
    void init({{ ctx.name }}_shared *);
    void pull();
    void push();
    {{ cls }}_prof * get_prof();
    {%- for lm in ctx.large_mem %}
    {%- if lm.part_id == part_id %}
    void * {{ lm.state.name }};
    {%- endif %}
    {%- endfor %}
};
{%- endfor %}

struct alignas(64) {{ ctx.name }} {
    {{ ctx.name }}_shared shared;
    {%- for (part_id, part) in ctx.parts.enumerate_ids() %}
    {%- set cls = ctx.name ~ "_" ~ part_id.0 %}
    {{ cls }}_decl part_{{ part_id.0 }};
    {%- endfor %}
    void step();
    void init();
    void step_mt(int cycles, int start_core=0);
    bool dump_prof(const char * filename);

    {%- for (sid, s) in ctx.shared.enumerate_ids() %}
    {%- if s.is_ext %}
    {{ s.width | int_ty }} get_{{ s.name }}();
    void set_{{ s.name }}({{ s.width | int_ty }} value);
    {%- endif %}
    {%- endfor %}
    {%- for lm in ctx.large_mem %}
    void * {{ lm.state.name }};
    {%- endfor %}
};