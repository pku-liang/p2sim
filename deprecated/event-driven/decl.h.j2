#pragma once

{% include "common/decl.h.j2" %}
#include <immintrin.h>

{%- for ext in ctx.ext_fns %}
{{ ext }}
{%- endfor %}

struct {{ ctx.name }}Syms {
    char __syms_start[0];
    {%- for state in ctx.states %}
    {{ state.width | int_ty }} {{ state.name }}
    {%- for dim in state.dims -%} [{{ dim }}] {%- endfor -%};
    {%- endfor %}
    char __syms_end[0];
    static void gprintf(const char *fmt, ...);
};

{%- if ctx.cfg.diff_test %}
struct {{ ctx.name }}Diff;
{%- endif %}

struct {{ ctx.name }}: public {{ ctx.name }}Syms {
    using act_t = uint{{ ctx.cfg.act_mask_width }}_t;

    void step();
    void step_mt(int cycles);
    void init();

    act_t __act_mask[{{ ctx.blocks.len() as u32 / ctx.cfg.act_mask_width + 1 }}];

{%- if ctx.cfg.prof %}
    static constexpr int PROF_HASH_WIDTH = 32;
    using prof_hash_t = __m256i_u[2];
    uint32_t __act_count[{{ ctx.blocks.len() }}];
    prof_hash_t __act_hash[{{ ctx.blocks.len() }}];
    prof_hash_t __act_hash_cur_cycle;
    std::mt19937_64 __rng;
    bool dump_act_info(const char * filename);
{%- endif %}

    {%- for state in ctx.iter_ext_state() %}
    {{ ctx.int_ty(state) }} get_{{ ctx.name(state) }}();
    void set_{{ ctx.name(state) }}({{ ctx.int_ty(state) }} value);
    {%- endfor %}

    {%- for reset in ctx.reset_states %}
    {{ ctx.int_ty(reset) }} {{ ctx.name(reset) }}$LAST;
    {%- endfor %}

    {%- for grp_id in 0..ctx.block_groups.len() %}
    void step_{{ grp_id }}();
    {%- endfor %}
    {%- for grp_id in 0..ctx.reset_groups.len() %}
    void reset_{{ grp_id }}();
    {%- endfor %}

{%- if ctx.cfg.diff_test %}
    {{ ctx.name }}Diff * diff;
{%- endif %}
    uint32_t __cycles;
};

{%- if ctx.cfg.diff_test %}
struct {{ ctx.name }}Diff: public {{ ctx.name }}Syms {
    {%- for blk_id in 0..ctx.blocks.len() %}
    void ministep_{{ blk_id }}();
    {%- endfor %}
    {%- for reset_id in 0..ctx.resets.len() %}
    void minireset_{{ reset_id }}();
    {%- endfor %}
};
{%- endif %}